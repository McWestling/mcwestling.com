---
// The one layout for every page. Home passes its own <main>; every other
// page (markdown in src/pages/) gets the header, nav and paper sheet.
const { title, description } = Astro.props.frontmatter ?? Astro.props;
const path = Astro.url.pathname;
const isHome = path === "/";
const current = (href: string) => (path === href ? "page" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f2e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171716" media="(prefers-color-scheme: dark)" />
    <title>{isHome ? title : `${title} · McWestling`}</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="icon" href="/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <!-- styles.css and app.js live in public/ and ship untouched by the build. -->
    <link rel="stylesheet" href="/styles.css" />
    <script is:inline src="/app.js" defer></script>
  </head>
  <body>
    {
      isHome ? (
        <slot />
      ) : (
        <main class="page-main">
          <header class="page-header">
            <a class="page-wordmark" href="/">McWestling</a>
            <nav aria-label="McWestling links">
              <a href="/about/" aria-current={current("/about/")}>About</a>
              <a href="mailto:inquiries@mcwestling.com">Contact</a>
            </nav>
          </header>
          <article class="page-content">
            <slot />
          </article>
        </main>
      )
    }
    <footer class="site-footer">
      <div>{isHome ? "McWestling LLC, New York" : <a href="/">McWestling LLC, New York</a>}</div>
      <div><a href="/privacy/" aria-current={current("/privacy/")}>Privacy</a></div>
    </footer>
  </body>
</html>
